<!-- Pipeline / stages hero. Replace {{ACCENT}} {{ACCENT_SOFT}} {{INK}} with the design brief palette (same as the logo). Copy to docs/assets/<name>.svg. Each box is 118 wide, 130 apart; add or remove
     boxes and move the arrows accordingly. Keep text to three short lines per box. -->
<svg xmlns="http://www.w3.org/2000/svg" width="980" height="220" viewBox="0 0 980 220" font-family="Segoe UI, Helvetica, Arial, sans-serif" font-size="13">
  <defs>
    <marker id="a" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="#57606a"/></marker>
  </defs>
  <rect width="980" height="220" fill="#ffffff"/>
  <rect x="14" y="14" width="952" height="170" rx="12" fill="{{ACCENT_SOFT}}" stroke="{{ACCENT}}"/>
  <text x="30" y="38" fill="{{INK}}" font-weight="bold">{{GROUP TITLE — e.g. PIPELINE, once per run}}</text>
  <g font-size="12" fill="#1f2937">
    <rect x="30" y="54" width="118" height="110" rx="8" fill="#fff" stroke="{{ACCENT}}"/>
    <text x="89" y="74" text-anchor="middle" font-weight="bold">{{1 · Step}}</text>
    <text x="89" y="96" text-anchor="middle">{{line}}</text><text x="89" y="112" text-anchor="middle">{{line}}</text><text x="89" y="128" text-anchor="middle">{{line}}</text>
    <rect x="160" y="54" width="118" height="110" rx="8" fill="#fff" stroke="{{ACCENT}}"/>
    <text x="219" y="74" text-anchor="middle" font-weight="bold">{{2 · Step}}</text>
    <text x="219" y="96" text-anchor="middle">{{line}}</text><text x="219" y="112" text-anchor="middle">{{line}}</text><text x="219" y="128" text-anchor="middle">{{line}}</text>
    <rect x="290" y="54" width="118" height="110" rx="8" fill="#fff" stroke="{{ACCENT}}"/>
    <text x="349" y="74" text-anchor="middle" font-weight="bold">{{3 · Step}}</text>
    <text x="349" y="96" text-anchor="middle">{{line}}</text><text x="349" y="112" text-anchor="middle">{{line}}</text><text x="349" y="128" text-anchor="middle">{{line}}</text>
    <g stroke="#57606a" stroke-width="1.5" marker-end="url(#a)">
      <line x1="148" y1="109" x2="160" y2="109"/><line x1="278" y1="109" x2="290" y2="109"/>
    </g>
  </g>
  <rect x="830" y="54" width="136" height="110" rx="12" fill="{{ACCENT_SOFT}}" stroke="{{ACCENT}}"/>
  <text x="898" y="80" text-anchor="middle" fill="{{INK}}" font-weight="bold" font-size="12">{{side note title}}</text>
  <text x="898" y="104" text-anchor="middle" fill="#1f2937" font-size="12">{{line}}</text>
  <text x="898" y="120" text-anchor="middle" fill="#1f2937" font-size="12">{{line}}</text>
  <text x="898" y="136" text-anchor="middle" fill="#1f2937" font-size="12">{{line}}</text>
</svg>
