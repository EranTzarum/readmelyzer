<!-- Logo frame. Copy to docs/assets/logo.svg, then DRAW the pictogram of the brief's metaphor where
     {{PICTOGRAM}} is, using shapes from references/logo-guide.md. Replace the color tokens with the brief's palette:
       {{ACCENT}}       the strong brand color (one detail, the focal accent)
       {{ACCENT_SOFT}}  a pale tint of the accent for the background tile (or delete the tile for a frameless mark)
       {{INK}}          a dark neutral for the main shapes
     Keep the 128 x 128 viewBox and a 12 px safe margin. No letters by default. -->
<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 128 128" role="img" aria-label="{{NAME}} logo">
  <rect x="2" y="2" width="124" height="124" rx="32" fill="{{ACCENT_SOFT}}"/>
  {{PICTOGRAM}}
</svg>
