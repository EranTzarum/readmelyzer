<!-- Project logo. Copy to docs/assets/logo.svg and fill the four slots.
     {{C1}} {{C2}}  gradient colors - pick ONE palette row below, a different one per project in the same workspace.
     {{MONO}}       1-2 letters (first letter of the name, or a short mark like "OS"). Keep it to 2 characters.
     {{MOTIF}}      one motif from the list below that says what the project does. Delete the line for none.
     The rounded square carries its own background, so the logo reads in light and dark mode.

     Palettes (C1 → C2):
       violet   #7C3AED → #DB2777     ocean    #0EA5E9 → #6366F1
       mint     #10B981 → #0EA5E9     sunset   #F59E0B → #EF4444
       graphite #475569 → #0F172A     coral    #FB7185 → #F97316
       forest   #22C55E → #065F46     indigo   #4F46E5 → #0EA5E9

     Motifs (white, drawn in the top-right corner, 128x128 canvas):
       lens     <g fill="none" stroke="#fff" stroke-width="5" opacity=".9"><circle cx="96" cy="32" r="12"/><path d="M105 41l9 9" stroke-linecap="round"/></g>
       spark    <path d="M98 14l5 13 13 5-13 5-5 13-5-13-13-5 13-5z" fill="#fff" opacity=".9"/>
       rocket   <path d="M112 16c-12 0-22 8-26 20l6 6c12-4 20-14 20-26zM86 42l-6 2 4 4z" fill="#fff" opacity=".9"/>
       check    <path d="M84 32l8 8 18-18" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" opacity=".9"/>
       brackets <path d="M90 18l-8 14 8 14M106 18l8 14-8 14" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" opacity=".9"/>
       grid     <g fill="#fff" opacity=".9"><rect x="84" y="18" width="10" height="10" rx="2"/><rect x="98" y="18" width="10" height="10" rx="2"/><rect x="84" y="32" width="10" height="10" rx="2"/><rect x="98" y="32" width="10" height="10" rx="2"/></g>
       nodes    <g fill="none" stroke="#fff" stroke-width="4" opacity=".9"><circle cx="88" cy="22" r="5"/><circle cx="110" cy="22" r="5"/><circle cx="99" cy="42" r="5"/><path d="M92 25l4 12M106 25l-4 12"/></g>
-->
<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 128 128" role="img" aria-label="{{NAME}} logo">
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="{{C1}}"/><stop offset="1" stop-color="{{C2}}"/>
    </linearGradient>
    <linearGradient id="shine" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".28"/><stop offset=".5" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <rect x="4" y="4" width="120" height="120" rx="30" fill="url(#g)"/>
  <rect x="4" y="4" width="120" height="120" rx="30" fill="url(#shine)"/>
  {{MOTIF}}
  <text x="58" y="92" text-anchor="middle" font-family="Segoe UI, Helvetica, Arial, sans-serif" font-size="56" font-weight="800" fill="#fff" letter-spacing="-2">{{MONO}}</text>
</svg>
